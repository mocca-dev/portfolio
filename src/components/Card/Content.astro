---
interface Props {
  title?: string;
  body?: string;
  hasTitleAction?: boolean;
}

const { title, body, hasTitleAction } = Astro.props;
---

<>
  {
    title &&
      (hasTitleAction ? (
        <div class="flex items-center justify-between gap-2 z-20">
          <h2 class="text-xl font-bold m-0">{title}</h2>
          <slot name="title-action" />
        </div>
      ) : (
        <h2 class="text-xl font-bold m-0 z-20">{title}</h2>
      ))
  }
  {body && <p class="m-0 font-light text-base">{body}</p>}
  <slot />
</>
