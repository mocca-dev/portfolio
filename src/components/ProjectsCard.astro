---
import Card from './Card/index.astro';
---

<Card
  colSpan="lg:col-span-2"
  rowSpan="md:row-span-2 gap-4"
  title="My top 5 apps"
>
  <div class="h-full overflow-x-auto">
    <div class="flex mt-3 gap-10 w-max mx-auto pb-2 whitespace-nowrap">
      <a
        href="https://navcycle.surge.sh"
        target="_blank"
        class="flex flex-col items-center"
      >
        <img
          class="app-logo"
          src="/navcycle-logo.png"
          height="35px"
          width="35px"
          alt=""
          style="filter: drop-shadow(0px 0px 10px rgba(255,255,255,0.15))"
        />
        <h2>Navcycle</h2>
      </a>
      <a
        href="https://stamps-one.vercel.app"
        target="_blank"
        class="flex flex-col items-center"
      >
        <img
          class="app-logo"
          src="/stamps.png"
          height="35px"
          width="35px"
          alt=""
          style="filter: drop-shadow(0px 0px 10px rgba(255,255,255,0.15))"
        />
        <h2>Stamps</h2>
      </a>
      <a
        href="https://infohub.vercel.app"
        target="_blank"
        class="flex flex-col items-center"
      >
        <img
          class="app-logo"
          src="/infohub.png"
          height="35px"
          width="35px"
          alt=""
        />
        <h2>InfoHub</h2>
      </a>
      <a
        href="https://lotapp.surge.sh"
        target="_blank"
        class="flex flex-col items-center"
      >
        <img
          class="app-logo"
          src="/isoLot.png"
          height="35px"
          width="35px"
          alt=""
        />
        <h2>Lot!</h2>
      </a>
      <a
        href="https://horariovillarino.mocca.vercel.app"
        target="_blank"
        class="flex flex-col items-center"
      >
        <img
          class="app-logo"
          src="/319.png"
          height="35px"
          width="35px"
          alt=""
        />
        <h2>Horarios 319</h2>
      </a>
    </div>
  </div>
</Card>
